# Everything the app reads. Real values live in Coolify env vars (never in git).
DATABASE_URL=postgres://user:pass@host:5432/pillion
SESSION_SECRET=            # long random string; signs the login cookie
PUBLIC_ORIGIN=https://pillion.housefulloflove.com
TELEGRAM_BOT_TOKEN=        # from @BotFather; Telegram features stay off while empty
TELEGRAM_BOT_USERNAME=     # without the @
TELEGRAM_WEBHOOK_SECRET=   # long random string; Telegram sends it back on every update
ANNOUNCE_CHAT_ID=          # optional: group/channel id for public announcements and 9pm prizes
VERIFY_CHAT_IDS=           # optional, comma-separated: only members of these chats can sign up
